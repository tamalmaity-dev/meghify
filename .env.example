# Copy to .env and fill in. The panel reads every value from the environment, so
# there is no config file to template.

# Required. This key encrypts secrets at rest (env vars, ssh keys, TOTP seeds).
# Generate one with: openssl rand -hex 32
# Never commit the generated value, and back it up: losing it means every
# stored secret has to be re-entered. The panel refuses to start in production
# when this is empty.
AUTH_SECRET=

# production or development. Development enables debug logging.
APP_ENV=production

# Where the panel listens inside its container.
PANEL_ADDR=:8080
# The URL users reach the panel on, used for absolute links.
PANEL_PUBLIC_URL=http://localhost:8080
# Host port published for the panel.
APP_PORT=8080

# SQLite lives in DATA_DIR and costs no extra memory or container. Postgres is
# not supported in this release; leave this set to sqlite.
DB_DRIVER=sqlite
# Override the sqlite file location. Defaults to ${DATA_DIR}/meghify.db.
DB_DSN=
# Reserved for the future Postgres backend.
DATABASE_URL=

DATA_DIR=/data

# The Docker Engine host. In the provided compose file this is the host socket.
DOCKER_HOST=unix:///var/run/docker.sock
# Required by docker-compose.yml. The panel container runs as uid/gid 65532 and
# must join the group that owns the Docker socket:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# Trust X-Forwarded-For / X-Real-IP for audit logs and rate limiting. Enable
# only when every request arrives through a reverse proxy you control.
TRUST_PROXY=false

# Session lifetime. API tokens use API_TOKEN_TTL.
SESSION_TTL=720h
API_TOKEN_TTL=8760h
PASSWORD_MIN_LEN=10
# Allow self-service registration after the first admin exists.
ALLOW_SIGNUP=false

# Job runner sizing. Each worker handles one queued job at a time.
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=3
METRICS_RETENTION_DAYS=14

# Deployment builds run inside a disposable helper container (git, nixpacks,
# railpack, docker CLI) on the target engine. Leave BUILD_HELPER_IMAGE empty to
# use the image published for this release; point it elsewhere to pin your own.
BUILD_HELPER_IMAGE=
# The reverse proxy deployed on demand for applications with domains.
# Traefik v3.6 or newer: earlier releases cannot talk to Docker Engine 29.
PROXY_IMAGE=traefik:v3.7
# Host ports the proxy binds; change these when nginx or another proxy already
# owns 80/443 on the server.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
# How many deployments may build at the same time. Builds are CPU-heavy; keep
# this at 1 on small servers.
BUILD_CONCURRENCY=1
# Optional ceilings for each build helper container: BUILD_CPU_LIMIT is whole
# cores (e.g. 1.5), BUILD_MEMORY_LIMIT takes bytes or 512m / 2g. Empty = no cap.
BUILD_CPU_LIMIT=
BUILD_MEMORY_LIMIT=

# How many built images per application a cleanup keeps (newest first). The
# image a running container serves from always survives.
IMAGE_KEEP=2
# Upper bound for the Docker build cache (helper container and engine),
# bytes or 512m / 8g. Enforced right after every release and by the hourly
# gc job; the prune keeps the most recently used cached layers first.
# Set 0 to leave the cache unbounded.
BUILD_CACHE_KEEP=8g

# Optional registry for pushing built images. When empty, images stay local to
# the node that built them.
REGISTRY_URL=
REGISTRY_USER=
REGISTRY_PASS=

# Reserved for the future database dump/upload implementation. Backup jobs
# currently fail with a clear "not implemented" error.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Traefik settings for the bundled stack.
TRAEFIK_VERSION=v3.7
# Email used for Let's Encrypt registration.
ACME_EMAIL=
